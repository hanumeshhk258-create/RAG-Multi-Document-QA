# =============================================================================
# Intelligent Document Question Answering System Using RAG
# Environment Configuration Template
# =============================================================================

# 1. Google Gemini API Configuration (REQUIRED)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AI Model Selection (OPTIONAL, Default: gemini-3.5-flash-lite)
# Recommended options:
# - gemini-3.5-flash-lite (fastest inference, low latency, high throughput)
# - gemini-flash-lite-latest (latest flash-lite endpoint)
# - gemini-3.8-flash (standard high-reasoning flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Web Server Port & Host Binding (OPTIONAL)
# Render automatically sets PORT (e.g. 10000). For local runs, defaults to 5000.
PORT=5000
HOST=0.0.0.0

# 4. Persistent Storage Directory (OPTIONAL)
# Set when mounting a Render Persistent Disk (e.g. /var/data).
# When set, uploaded documents, FAISS index, and analytics.db will reside here.
# Leave blank to use repository-relative paths (documents/, vectorstore/, analytics.db).
RAG_DATA_DIR=

# 5. Pipeline Diagnostics & Performance (OPTIONAL)
# Set to 'true' for structured per-request pipeline traces in server logs.
DEBUG_RAG=false

# 6. Generation Timeout & Limits (OPTIONAL)
# Maximum generation timeout in seconds (default: 20)
LLM_TIMEOUT=20
MAX_CONTEXT_CHUNKS=6
MAX_OUTPUT_TOKENS=512

# 7. Supabase Persistent Cloud Storage (REQUIRED for Vercel Serverless Deployment)
# Connects to Supabase Storage for private PDFs and Supabase Postgres with pgvector for chunks, metadata, and analytics.
# Leave blank for local development or Render container persistence (defaults to local disk).

# Supabase Project REST URL (from Supabase Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (SECRET - SERVER-SIDE ONLY)
# Used by Flask backend for administrative access to private bucket and database.
# NEVER expose this key in client-side JavaScript, frontend HTML, or source control!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase Anonymous Key (PUBLIC / CLIENT-SIDE COMPATIBLE - OPTIONAL)
# Read-only or RLS-restricted public key.
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase PostgreSQL Connection String with pgvector (SECRET - SERVER-SIDE ONLY)
# Format: postgresql://postgres.[project-id]:[password]@[host]:6543/postgres
# Direct connection URI used by psycopg2 for vector similarity search and metadata persistence.
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Private Storage Bucket Name (OPTIONAL, Default: rag-documents)
# Must be configured as a private bucket in Supabase Storage to ensure documents remain private.
SUPABASE_STORAGE_BUCKET=rag-documents

# 8. Embedding Provider (OPTIONAL, Default: onnx)
# Options:
# - onnx: Uses lightweight FastOnnxEmbeddings (384 dimensions, all-MiniLM-L6-v2, ~90MB ONNX)
# - gemini: Uses Google Gemini gemini-embedding-001 (384 dimensions, 0MB local model footprint)
EMBEDDING_PROVIDER=onnx